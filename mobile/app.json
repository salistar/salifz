{
  "expo": {
    "name": "Salifz",
    "slug": "salifz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salifz",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salifz.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for face recognition and gender verification",
        "NSMicrophoneUsageDescription": "Microphone is used for Quran recitation and voice calls",
        "NSFaceIDUsageDescription": "Face ID is used for secure login"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "package": "com.salifz.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Salifz to access your camera for face recognition"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Salifz to use Face ID for secure login"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#10B981"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    }
  }
}
