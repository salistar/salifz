MOCK_EMAIL=true

# ============================================
# ðŸ“± SMS SERVICE - Twilio
# ============================================
# Service d'envoi de SMS pour:
# - VÃ©rification du numÃ©ro de tÃ©lÃ©phone (OTP)
# - Alertes importantes

# Twilio Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# Twilio Verify Service (recommandÃ© pour OTP)
TWILIO_VERIFY_SERVICE_SID=

# Mode simulation (development) - N'envoie pas de vrais SMS
MOCK_SMS=true

# ============================================
# ðŸ”¢ OTP CONFIGURATION
# ============================================
# Configuration des codes de vÃ©rification

# Longueur du code OTP
OTP_LENGTH=6

# DurÃ©e de validitÃ© en minutes
OTP_EXPIRY_MINUTES=10

# Nombre maximum de tentatives
OTP_MAX_ATTEMPTS=3

# DÃ©lai entre les renvois (en secondes)
OTP_RESEND_DELAY=60

# Code OTP fixe pour les tests (uniquement en dev avec SIMULATION_MODE=true)
SIMULATION_OTP=123456

# ============================================
# ðŸ‘¤ FACE RECOGNITION - Biometric Verification
# ============================================
