# Templates SendGrid (IDs des templates)
SENDGRID_TEMPLATE_WELCOME=d-xxxxxxxxxxxxx
SENDGRID_TEMPLATE_OTP=d-xxxxxxxxxxxxx
SENDGRID_TEMPLATE_RESET_PASSWORD=
SENDGRID_TEMPLATE_WEEKLY_REPORT=d-xxxxxxxxxxxxx

# Alternative: SMTP (Nodemailer) - dÃ©commenter si pas SendGrid
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

