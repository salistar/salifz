AZURE_FACE_KEY=

# AWS Rekognition (si FACE_API_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REKOGNITION_COLLECTION=salifz-faces

# ============================================
# ðŸ¤– AI SERVICE - OpenAI
