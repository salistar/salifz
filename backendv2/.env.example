# ============================================
# ðŸ”Œ SOCKET.IO - Real-time Communication
# ============================================
# Configuration de Socket.IO pour:
# - Chat en temps rÃ©el
# - Appels audio/vidÃ©o (signaling)
# - Notifications en temps rÃ©el
# - PrÃ©sence des utilisateurs
# - Halaqa (groupes d'Ã©tude)

# Timeouts (en ms)
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
SOCKET_CONNECT_TIMEOUT=45000

# Taille max des messages
SOCKET_MAX_HTTP_BUFFER_SIZE=1000000

# CORS pour Socket.IO
SOCKET_CORS_ORIGIN=*

# Adapter Redis (pour scaling - plusieurs serveurs)
# DÃ©commenter en production avec plusieurs instances
# SOCKET_REDIS_ADAPTER=true

# ============================================
# ðŸ’¬ CHAT SYSTEM
# ============================================
# Configuration du systÃ¨me de chat
# 
# âš ï¸ IMPORTANT: Pour que le chat fonctionne, vous devez:
# 1. Installer socket.io: npm install socket.io
# 2. Ajouter le handler Socket.IO dans index.js (voir ci-dessous)
# 3. CrÃ©er les modÃ¨les Conversation et Message
# 4. Ajouter les routes chat

# Limites du chat
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_ATTACHMENTS=5
CHAT_ATTACHMENT_MAX_SIZE=10485760
CHAT_HISTORY_LIMIT=100

# RÃ©tention des messages (en jours, 0 = illimitÃ©)
CHAT_MESSAGE_RETENTION_DAYS=0

# Types de fichiers autorisÃ©s pour les piÃ¨ces jointes
CHAT_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,audio/mpeg,audio/wav

# ============================================
# ðŸ“ž CALLS - WebRTC Signaling
# ============================================
# Configuration pour les appels audio/vidÃ©o
#
# âš ï¸ IMPORTANT: Le backend ne gÃ¨re que le signaling WebRTC.
# La communication audio/vidÃ©o se fait en peer-to-peer.
# Pour la production, vous aurez besoin d'un serveur TURN.

# Activer les appels
CALLS_ENABLED=true
CALLS_AUDIO_ENABLED=true
CALLS_VIDEO_ENABLED=true

# DurÃ©e max d'un appel (en secondes, 0 = illimitÃ©)
CALLS_MAX_DURATION=3600

# Serveurs STUN/TURN (pour traversÃ©e NAT)
