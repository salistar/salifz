# ============================================
# ðŸ–¥ï¸  SERVER CONFIGURATION
# ============================================

# Port du serveur (doit correspondre Ã  votre configuration mobile)
PORT=8088

# Environnement: development | staging | production
NODE_ENV=development

# Version de l'API
API_VERSION=v1

# Nom de l'application
APP_NAME=Salifz

# URLs de l'application
APP_URL=https://salifz.com
API_URL=http://192.168.1.4:8088/api/v1
WS_URL=http://192.168.1.4:8088

# URLs de production (dÃ©commenter en prod)
# APP_URL=https://salifz.com
# API_URL=https://api.salifz.com/api/v1
# WS_URL=wss://api.salifz.com

# Email de support
SUPPORT_EMAIL=support@salifz.com

# ============================================
# ðŸ—„ï¸  DATABASE - MongoDB
# ============================================
# MongoDB est la base de donnÃ©es principale pour stocker
# les utilisateurs, progrÃ¨s, achievements, etc.

# Development (local)
MONGODB_URI=mongodb://localhost:27017/salifz

# Production (MongoDB Atlas - dÃ©commenter en prod)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/salifz?retryWrites=true&w=majority

# Test database
MONGODB_TEST_URI=mongodb://localhost:27017/salifz_test

# Options MongoDB
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# ============================================
# ðŸ”´ REDIS - Cache & Sessions & Socket.IO
# ============================================
# Redis est utilisÃ© pour:
# - Cache des donnÃ©es frÃ©quemment accÃ©dÃ©es
# - Sessions utilisateurs
# - Adapter Socket.IO pour scaling horizontal
# - File d'attente pour les tÃ¢ches en arriÃ¨re-plan
# - Stockage temporaire des OTP

# Development (local)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Production (Redis Cloud - dÃ©commenter en prod)
# REDIS_URL=redis://user:password@redis-cloud.com:6379

# DurÃ©es de cache (en secondes)
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400
REDIS_OTP_TTL=600

# ============================================
# ðŸ” JWT AUTHENTICATION
# ============================================
# JSON Web Tokens pour l'authentification des utilisateurs

# âš ï¸ CHANGER EN PRODUCTION ! Utiliser une clÃ© longue et alÃ©atoire
JWT_SECRET=

# ClÃ© sÃ©parÃ©e pour les refresh tokens
JWT_REFRESH_SECRET=

# DurÃ©e de validitÃ© des tokens
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Issuer et Audience (optionnel, pour validation stricte)
JWT_ISSUER=salifz
JWT_AUDIENCE=salifz-app

# ============================================
# ðŸ“§ EMAIL SERVICE - SendGrid
# ============================================
# Service d'envoi d'emails pour:
# - VÃ©rification d'email (OTP)
# - RÃ©initialisation de mot de passe
# - Notifications importantes
# - Rapports hebdomadaires

# SendGrid API
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@salifz.com
