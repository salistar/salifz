# ============================================
# Salifz Backend - Environment Variables
# ============================================

NODE_ENV=development
PORT=8088

# Database
MONGODB_URI=mongodb://localhost:27017/salifz
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
MOCK_SMS=true

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=noreply@salifz.com
MOCK_EMAIL=true

# AI Services
OPENAI_API_KEY=your_openai_key

# Azure Face API (Gender Detection)
AZURE_FACE_KEY=your_azure_face_key
AZURE_FACE_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# Stripe
STRIPE_SECRET_KEY=your_stripe_key

# Socket.IO
SOCKET_CORS_ORIGIN=*

# Gamification
HEARTS_REFILL_HOURS=4
